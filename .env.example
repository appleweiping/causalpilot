# Browser-facing API. The static GitHub Pages build intentionally omits a live API
# and falls back to the seeded evidence simulator.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Build-only values used by the static GitHub Pages workflow.
STATIC_EXPORT=false
BASE_PATH=

# Keep local and container output deterministic and quiet.
NEXT_TELEMETRY_DISABLED=1
